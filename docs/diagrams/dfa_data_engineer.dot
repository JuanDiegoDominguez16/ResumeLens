digraph dfa_data_engineer {
    rankdir=TB;
    labelloc="t";
    label="Data Engineer, M = (Q, S, d, q0, F)\n|Q| = 2^5 = 32 states, |S| = 33 symbols, q0 = q0, F = {qDE}\nArrows show the transitions that fill a slot. The self loops that make d total, section 4.5, are not drawn.\n\lslot 1, query language: SQL\lslot 2, orchestration: AIRFLOW\lslot 3, distributed processing: SPARK\lslot 4, database: MYSQL or POSTGRESQL\lslot 5, data platform: DATABRICKS\l";
    fontname="Helvetica";
    node [shape=circle, fontname="Helvetica", fontsize=10, width=0.3];
    edge [fontname="Helvetica", fontsize=8, arrowsize=0.6];

    start [shape=none, label="", width=0, height=0];
    { rank=same; "q0" [shape=circle, label="q0"]; }
