digraph fst_version_control {
    rankdir=LR;
    labelloc="t";
    label="Stage 2 transducer, Version Control";
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=11];
    edge [fontname="Helvetica", fontsize=10];

    start [shape=none, label="", width=0, height=0];
    "q0" [shape=circle];
    "qf" [shape=doublecircle];
    start -> "q0";

    "q0" -> "qf" [label="Git / GIT"];
}
